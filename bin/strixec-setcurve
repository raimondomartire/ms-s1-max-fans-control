#!/usr/bin/env python3
"""
strixec-setcurve - write a fan curve into the Minisforum MS-S1 MAX EC table
via /dev/strixec. The firmware reads this table live.

EC table (confirmed by the alignment experiment, 2026-10-16):
  Fan1 base 0x10 | Fan2 base 0x30
  8 records of 3 bytes each, record k at base + 3*k:
    base + 3*k + 0 : raw duty value for the band (lower, upper]
    base + 3*k + 1 : upper temperature of the band (°C)
    base + 3*k + 2 : lower temperature of the band (°C)
  Record 0 covers everything up to its upper bound, so it must never be 0 on a
  curve that should keep the fans running (stock uses 0 there: fans off below 25 °C).

Duty scale: the raw value that means full speed is the "fan scale" (default 100,
stored in /etc/strixec/fan-scale). Profiles are written as a percentage of that
scale. Measurements by James (plan-hwmon.md, Phase 0) put the knee at 48: the raw
value is RPM/100 and full speed is about 4800 RPM. Use `set-scale 48` to act on it.
Non-zero profile values are never below MIN_RAW (9), the lowest speed the fans
were run at without stalling (not yet tested from standstill).

Usage:
  sudo strixec-setcurve <profile>        # ultrasilenzioso|silenzioso|leggero|bilanciato|aggressivo|stock
  sudo strixec-setcurve custom T:P,...   # 7 points, P = percent of full speed
  sudo strixec-setcurve set-scale N      # raw value for full speed (10..255), re-applies the active profile
  sudo strixec-setcurve test P SECONDS   # hold a fixed speed (P percent), then restore the previous table
  sudo strixec-setcurve show             # print the current EC table
  strixec-setcurve dump-profiles         # JSON {"scale", "profiles"} in percent (used by the GUI)
"""
import sys, os, json, signal, time

DEV = "/dev/strixec"
FAN_BASES = [0x10, 0x30]          # fan1, fan2
STATE = "/run/strixec/profile"
SCALE_FILE = "/etc/strixec/fan-scale"
DEFAULT_SCALE = 100
SCALE_MIN, SCALE_MAX = 10, 255
NREC = 7                 # points in a profile (one per band boundary)
NREC_EC = 8              # records the EC holds per fan
MIN_RAW = 9              # lowest raw value used for a non-zero duty (tested spinning)

# profile -> 7 (upper_temp_C, percent of full speed); the percent applies for band up to that temp.
# Above the last record's temperature the firmware holds the last band's duty.
# Last temperature of every profile is PROTECT_LOWER (90 °C) or below.
PROFILES = {
    "ultrasilenzioso": [(55, 6),  (67, 10), (75, 15), (80, 24),
                        (84, 42), (87, 70), (90, 100)],
    "silenzioso":      [(50, 12), (60, 20), (68, 28), (76, 42),
                        (82, 60), (86, 85), (90, 100)],
    "leggero":         [(48, 20), (56, 32), (64, 45), (72, 62),
                        (80, 80), (85, 95), (90, 100)],
    "bilanciato":      [(45, 30), (54, 45), (62, 60), (70, 75),
                        (78, 90), (85, 100), (90, 100)],
    "aggressivo":      [(40, 45), (48, 60), (55, 75), (62, 88),
                        (70, 100), (80, 100), (90, 100)],
}
# "stock" is the factory table read from this machine, written raw whatever the scale.
# Records as (value, upper, lower), from the alignment experiment (plan-hwmon.md, Phase 0 step 7).
STOCK = [(0, 25, 0), (16, 45, 25), (18, 60, 45), (25, 72, 60),
         (29, 83, 72), (34, 88, 83), (36, 93, 88), (40, 95, 90)]
# Record 7 is treated as the firmware's protection band (decision, plan-hwmon.md Phase 0 step 7):
# its bounds stay at the stock 90-95 °C, its value is never lowered below the stock 40,
# and profiles end at 90 °C so that record 6 stops where record 7 starts.
PROTECT_VALUE_MIN = STOCK[7][0]
PROTECT_UPPER = STOCK[7][1]
PROTECT_LOWER = STOCK[7][2]
NAMED = list(PROFILES) + ["stock"]


def ec_write(off, val):
    with open(DEV, "r+b") as f:
        f.seek(off)
        f.write(bytes([val & 0xFF]))


def ec_read(off):
    with open(DEV, "rb") as f:
        f.seek(off)
        return f.read(1)[0]


def get_scale():
    try:
        with open(SCALE_FILE) as f:
            v = int(f.read().strip())
        if SCALE_MIN <= v <= SCALE_MAX:
            return v
    except (OSError, ValueError):
        pass
    return DEFAULT_SCALE


def to_raw(pct, scale):
    return max(0, min(scale, int(round(pct * scale / 100.0))))


def to_raw_points(pct_pts, scale):
    """Percent points -> raw points, never below MIN_RAW unless the duty is 0."""
    out = []
    for t, d in pct_pts:
        raw = to_raw(d, scale)
        if d > 0:
            raw = max(MIN_RAW, raw)
        out.append((t, raw))
    return out


def profile_raw(name, scale):
    """Raw points for a named profile (7 points)."""
    if name == "stock":
        return list(STOCK)
    return to_raw_points(PROFILES[name], scale)


def _validate_raw(pts):
    if len(pts) != NREC:
        raise SystemExit("profile must have %d points" % NREC)
    prev_t = -1
    for t, d in pts:
        if not (0 <= t <= 120) or not (0 <= d <= 255):
            raise SystemExit("point out of range (temp 0..120, duty 0..255): %r" % ((t, d),))
        if t <= prev_t:
            raise SystemExit("temperatures must be strictly increasing")
        prev_t = t
    if pts[-1][0] > PROTECT_LOWER:
        raise SystemExit("the last temperature must be %d °C or less (record 7 is the protection band)"
                         % PROTECT_LOWER)


def points_to_records(pts):
    """7 (temp, duty) points -> 8 (value, upper, lower) records.
    Records 0-6: band k is (previous upper, upper] with the duty of point k; band 0 starts at 0.
    Record 7 is the protection band: bounds stay at the stock 90-95 °C, and its value is the
    last duty if that is higher than the stock value, never lower."""
    _validate_raw(pts)
    recs = []
    prev = 0
    for t, d in pts:
        recs.append((int(d), int(t), prev))
        prev = int(t)
    protect_value = max(PROTECT_VALUE_MIN, int(pts[-1][1]))
    recs.append((protect_value, PROTECT_UPPER, PROTECT_LOWER))
    return recs


def _table_offsets():
    return [base + k for base in FAN_BASES for k in range(3 * NREC_EC)]


def _write_table(recs):
    """Write 8 (value, upper, lower) records to both fans. On a failed write, restore the previous bytes."""
    if len(recs) != NREC_EC:
        raise SystemExit("table must have %d records" % NREC_EC)
    # Snapshot the live table first: the firmware reads it at any moment, so a
    # write that fails half-way must not leave a mixed curve behind.
    saved = [(off, ec_read(off)) for off in _table_offsets()]
    try:
        for base in FAN_BASES:
            for k, (value, upper, lower) in enumerate(recs):
                ec_write(base + 3 * k + 0, int(value))
                ec_write(base + 3 * k + 1, int(upper))
                ec_write(base + 3 * k + 2, int(lower))
    except OSError as e:
        restore_bytes(saved)
        raise SystemExit("write failed (%s): previous curve restored, nothing applied" % e)


def restore_bytes(saved):
    for off, val in saved:
        try:
            ec_write(off, val)
        except OSError:
            pass


def apply_points(pts_pct, name):
    """Apply a curve given in percent of full speed."""
    scale = get_scale()
    _write_table(points_to_records(to_raw_points(pts_pct, scale)))
    _write_state(name)
    print("curve '%s' applied (scale %d) to fan1(0x%02X) + fan2(0x%02X)." % (name, scale, FAN_BASES[0], FAN_BASES[1]))
    show()


def apply_profile(name):
    if name == "stock":
        _write_table(STOCK)
        _write_state(name)
        print("curve 'stock' applied (factory bytes) to fan1(0x%02X) + fan2(0x%02X)." % (FAN_BASES[0], FAN_BASES[1]))
        show()
    else:
        apply_points(PROFILES[name], name)


def set_scale(value):
    if not (SCALE_MIN <= value <= SCALE_MAX):
        raise SystemExit("scale must be %d..%d" % (SCALE_MIN, SCALE_MAX))
    os.makedirs(os.path.dirname(SCALE_FILE), exist_ok=True)
    with open(SCALE_FILE, "w") as f:
        f.write("%d\n" % value)
    os.chmod(SCALE_FILE, 0o644)
    print("fan scale set to %d (raw value for full speed)." % value)
    # Re-apply the active profile so the table matches the new scale.
    try:
        with open(STATE) as f:
            active = f.read().strip()
    except OSError:
        active = ""
    if active in PROFILES:
        apply_profile(active)


def speed_test(pct, seconds):
    """Hold a fixed fan speed for `seconds`, then put the previous table back."""
    scale = get_scale()
    raw = to_raw(pct, scale) if pct == 0 else max(MIN_RAW, to_raw(pct, scale))
    saved = [(off, ec_read(off)) for off in _table_offsets()]
    flat = [(t, raw) for t in (30, 40, 50, 60, 70, 80, 90)]

    def stop(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        _write_table(points_to_records(flat))
        print("holding %d%% (raw %d of %d) for %d s, then restoring the previous curve." % (pct, raw, scale, seconds))
        sys.stdout.flush()
        time.sleep(seconds)
    finally:
        restore_bytes(saved)
        print("previous curve restored.")


def parse_points(spec):
    """'55:6,68:10,...' -> [(55,6),(68,10),...]"""
    pts = []
    for chunk in spec.split(","):
        try:
            t, d = chunk.split(":")
            pts.append((int(t), int(d)))
        except ValueError:
            raise SystemExit("bad point %r: expected TEMP:PERCENT, e.g. 55:6,68:10,..." % chunk)
    return pts


def _write_state(name):
    try:
        os.makedirs("/run/strixec", exist_ok=True)
        with open(STATE, "w") as f:
            f.write(name + "\n")
        os.chmod(STATE, 0o644)
    except OSError:
        pass


def show():
    for base in FAN_BASES:
        cells = []
        for k in range(NREC_EC):
            v = ec_read(base + 3 * k + 0)
            u = ec_read(base + 3 * k + 1)
            l = ec_read(base + 3 * k + 2)
            cells.append("(%d-%d]->%d" % (l, u, v))
        print("  fan@0x%02X: %s" % (base, "  ".join(cells)))


def dump_profiles():
    scale = get_scale()
    out = {}
    for name in NAMED:
        if name == "stock":
            # display: (upper temp, duty as % of full speed) for the 7 bands above the first record
            out[name] = [[u, round(v * 100.0 / scale, 1)] for v, u, _ in STOCK[1:]]
        else:
            out[name] = [[t, d] for t, d in PROFILES[name]]
    print(json.dumps({"scale": scale, "profiles": out}))


FORCE_FLAG = "--force"          # write even if the board is not recognised
ALLOW_OFF_FLAG = "--allow-off"  # allow a 0 % duty (fans can stop)
# Substring of the DMI product or board name of the MS-S1 MAX. Not yet checked
# against the exact string of every BIOS revision: confirm with
#   cat /sys/class/dmi/id/product_name /sys/class/dmi/id/board_name
BOARD_MARKERS = ("MS-S1",)


def board_check(force):
    """Refuse EC writes on a board we have not identified (guard from ec-su_axb35's load check)."""
    if force:
        return
    names = []
    for f in ("product_name", "board_name"):
        try:
            with open("/sys/class/dmi/id/" + f) as fh:
                names.append(fh.read().strip())
        except OSError:
            pass
    if not any(m in n.upper() for n in names for m in BOARD_MARKERS):
        raise SystemExit("refusing to write the EC: this is not a recognised MS-S1 MAX (DMI: %s). "
                         "Use %s only if you are sure." % (", ".join(names) or "unreadable", FORCE_FLAG))


def main():
    flags = set(x for x in sys.argv[1:] if x.startswith("--"))
    args = [x for x in sys.argv[1:] if not x.startswith("--")]
    if not args:
        print(__doc__)
        return
    force = FORCE_FLAG in flags
    allow_off = ALLOW_OFF_FLAG in flags
    a = args[0]
    if a == "dump-profiles":
        dump_profiles()
    elif a == "show":
        print("fan scale: %d" % get_scale())
        show()
    elif a == "custom":
        if len(args) < 2:
            print("usage: strixec-setcurve custom T1:P1,T2:P2,... (%d points, percent 0..100)" % NREC)
            sys.exit(1)
        pts = parse_points(args[1])
        if len(pts) != NREC or any(not (0 <= d <= 100) for _, d in pts):
            raise SystemExit("custom needs %d points with percent 0..100" % NREC)
        if not allow_off and any(d == 0 for _, d in pts):
            raise SystemExit("a 0 %% duty stops the fans; use %s to allow it" % ALLOW_OFF_FLAG)
        board_check(force)
        apply_points(pts, "personalizzato")
    elif a == "set-scale":
        if len(args) < 2:
            raise SystemExit("usage: strixec-setcurve set-scale N   (N = %d..%d)" % (SCALE_MIN, SCALE_MAX))
        board_check(force)
        set_scale(int(args[1]))
    elif a == "test":
        if len(args) < 3:
            raise SystemExit("usage: strixec-setcurve test PERCENT SECONDS")
        pct, secs = int(args[1]), int(args[2])
        if not (0 <= pct <= 100) or not (1 <= secs <= 120):
            raise SystemExit("test needs percent 0..100 and 1..120 seconds")
        if pct == 0 and not allow_off:
            raise SystemExit("a 0 %% test stops the fans; use %s to allow it" % ALLOW_OFF_FLAG)
        board_check(force)
        speed_test(pct, secs)
    elif a in NAMED:
        board_check(force)
        apply_profile(a)
    else:
        print("unknown profile: %s (use: %s, custom, set-scale, test, show)" % (a, ", ".join(NAMED)))
        sys.exit(1)


if __name__ == "__main__":
    main()
